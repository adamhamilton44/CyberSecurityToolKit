* text=auto eol=lf
*.enc binary
*.exe binary
*.png binary
*.zip filter=lfs diff=lfs merge=lfs -text

# Preserve intentional spacing in wordlists, ASCII art, and reference data.
Other/Wordlists/*.txt whitespace=-trailing-space
scripts/DoSBombs/README.md whitespace=-trailing-space
scripts/README.md whitespace=-blank-at-eof
scripts/lib/Fonts whitespace=-trailing-space,-blank-at-eof
scripts/lib/GD_*.txt whitespace=-trailing-space
