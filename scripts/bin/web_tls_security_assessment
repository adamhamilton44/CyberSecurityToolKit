#!/usr/bin/env bash
# CSTK DEFENSE #2: bounded, read-only assessment of one explicitly supplied URL.
set -o pipefail
umask 077
export LC_ALL=C
R=$'\e[1;31m'; G=$'\e[1;32m'; Y=$'\e[1;33m'; C=$'\e[1;36m'; X=$'\e[0m'
usage() {
    printf '%s\n' 'Usage: web_tls_security_assessment HTTP_OR_HTTPS_URL' \
        'Uses GET (Range: bytes=0-0), OPTIONS and bounded TLS handshakes.' \
        'Does not follow redirects, send credentials, replay cookies or test unsafe methods.' \
        'Reports: per-user CSTK Loot/web-tls-* directories' \
        'Exit: 0 assessment completed (findings may exist), 1 output error, 2 invalid target.'
}
[[ ${1:-} == --help || ${1:-} == -h ]] && { usage; exit 0; }
[[ $# == 1 ]] || { usage >&2; exit 2; }
target=$1
# Reject userinfo, URL fragments, control characters, whitespace and ambiguous authority.
[[ $target != *[[:space:][:cntrl:]]* && $target != *'#'* && $target != *$'\\'* ]] || { echo 'Invalid URL.' >&2; exit 2; }
if [[ $target =~ ^(https?)://(\[[0-9A-Fa-f:]+\]|[a-zA-Z0-9.-]+)(:([0-9]{1,5}))?([/?].*)?$ ]]; then
    scheme=${BASH_REMATCH[1]}; authority_host=${BASH_REMATCH[2]}
    port=${BASH_REMATCH[4]}; suffix=${BASH_REMATCH[5]}
else
    echo 'Supply a complete http:// or https:// URL without credentials or fragments.' >&2; exit 2
fi
host=${authority_host#[}; host=${host%]}
[[ -n $port ]] || { [[ $scheme == https ]] && port=443 || port=80; }
port=$((10#$port))
(( port >= 1 && port <= 65535 )) || { echo 'Invalid port.' >&2; exit 2; }
[[ -n $suffix ]] || suffix=/
[[ $suffix == \?* ]] && suffix="/$suffix"
target="$scheme://$authority_host:$port$suffix"
# Query values may contain tokens: never include them in reports or logs.
display_target="${target%%\?*}"
[[ $target == *\?* ]] && display_target+='?[redacted]'
base=${CSTK_USER_DATA_DIR:-${user_home:-$HOME}/.local/share/cstk}
loot=${CSTK_LOOT_DIR:-$base/Loot}; logs=${CSTK_LOG_DIR:-$base/Logs}
mkdir -p -- "$loot" || exit 1
report_dir=$(mktemp -d "$loot/web-tls-$(date -u +%Y%m%dT%H%M%SZ)-XXXXXX") || exit 1
report="$report_dir/report.txt"
work=$(mktemp -d) || exit 1
trap 'rm -rf -- "$work"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
touch "$report" || exit 1
declare -A totals=([HIGH]=0 [MEDIUM]=0 [LOW]=0 [PASS]=0 [SKIP]=0 [INFO]=0)
# Remove terminal escapes/control bytes in all remote evidence.
finding() {
    local severity=$1 line color=$C; shift
    # Flatten remote newlines so evidence cannot impersonate another finding.
    line=$(printf '[%s] %s' "$severity" "$*" | tr '\r\n' '  ' | tr -d '\000-\010\013-\037\177')
    [[ ${#line} -le 4096 ]] || line="${line:0:4096} [truncated]"
    printf '%s\n' "$line" >> "$report" || exit 1
    totals[$severity]=$(( ${totals[$severity]} + 1 ))
    if [[ -t 1 ]]; then
        case "$severity" in
            HIGH) color=$R ;; MEDIUM|LOW|SKIP) color=$Y ;; PASS) color=$G ;;
        esac
        printf '%s%s%s\n' "$color" "$line" "$X"
    else printf '%s\n' "$line"; fi
}
finding INFO "CSTK Web/TLS assessment: $display_target"
finding INFO "UTC: $(date -u +%FT%TZ); GET/OPTIONS only; redirects are recorded, never followed."
finding INFO 'Results cover this unauthenticated URL and local client capabilities, not every application route or cipher.'
header() {
    awk -v key="$1" 'index($0,":") {n=substr($0,1,index($0,":")-1); if(tolower(n)==tolower(key)) {v=substr($0,index($0,":")+1); sub(/^[ \t]+/,"",v); sub(/[ \t]+$/,"",v); print v}}' "$2"
}
redirect_destination() {
    local value=$1 origin
    if [[ $value =~ ^([Hh][Tt][Tt][Pp][Ss]?)://([^/?#]+) ]]; then
        origin=${BASH_REMATCH[2]}; origin=${origin##*@}
        printf '%s://%s/[path/query/fragment redacted]' "${BASH_REMATCH[1],,}" "$origin"
    else printf '%s' '[relative or non-HTTP destination redacted]'; fi
}
is_https_redirect() {
    local response=$1 destination=$2
    [[ $response =~ ^HTTP/[^[:space:]]+[[:space:]]+(301|302|303|307|308)([[:space:]]|$) &&
        $destination != *$'\n'* && ${destination,,} =~ ^https://[^/[:space:]]+([/?#]|$) ]]
}
request() {
    local url=$1 method=$2 out=$3 rc
    local -a range=()
    [[ $method == GET ]] && range=(--range 0-0)
    # -q must be first: ignore ~/.curlrc (credentials, proxy, insecure or redirects).
    curl -q --noproxy '*' --proto '=http,https' --connect-timeout 5 --max-time 10 \
        --max-filesize 1048576 --silent --show-error --globoff \
        --request "$method" "${range[@]}" --dump-header "$work/raw" --output /dev/null \
        --url "$url" 2>"$work/curl-error"
    rc=$?
    # Keep the final complete header block; omit interim headers and trailers.
    tr -d '\r' < "$work/raw" | awk '
        /^HTTP\// {block=$0 "\n"; active=1; complete=0; next}
        active {block=block $0 "\n"; if ($0=="") {active=0; complete=1}}
        END {if (complete) printf "%s",block}' > "$out"
    if ! [[ $(head -n 1 "$out") =~ ^HTTP/[^[:space:]]+[[:space:]]+[2-5][0-9][0-9]([[:space:]]|$) ]]; then
        : > "$out"
        [[ $rc != 0 ]] || rc=52
    elif (( rc == 0 )); then return 0; fi
    if (( rc == 63 )) && [[ -s $out ]]; then
        finding INFO 'Body exceeded the size limit; response headers remain available.'
        return 0
    fi
    if (( rc == 60 )); then
        finding HIGH 'curl rejected certificate trust, validity or hostname verification; no insecure retry performed.'
    else
        finding SKIP "HTTP request unavailable (curl exit $rc); transport error is not evidence of secure configuration."
    fi
    return 1
}
audit_headers() {
    local f=$1 key value lower cookie attrs name count=0 csp
    csp=$(header Content-Security-Policy "$f"); csp=${csp,,}
    for key in Strict-Transport-Security Content-Security-Policy X-Frame-Options X-Content-Type-Options Referrer-Policy Permissions-Policy; do
        value=$(header "$key" "$f"); lower=${value,,}
        if [[ $key == Strict-Transport-Security && $scheme == http ]]; then
            finding INFO 'HSTS is only effective over HTTPS.'; continue
        fi
        if [[ -z $value ]]; then
            if [[ $key == X-Frame-Options && $csp =~ (^|\;)[[:space:]]*frame-ancestors[[:space:]] ]]; then
                finding INFO 'X-Frame-Options absent; CSP frame-ancestors is present. Review that policy for framing protection.'
            else finding MEDIUM "$key missing; review applicability for this response."; fi
        elif [[ $key == Strict-Transport-Security ]]; then
            if [[ $value == *$'\n'* ]]; then
                finding MEDIUM 'Multiple HSTS headers observed; browser behavior may select a different policy.'
            elif [[ $lower =~ (^|\;)[[:space:]]*max-age=([0-9]+)($|\;|[[:space:]]) ]] && [[ ${BASH_REMATCH[2]} =~ [1-9] ]]; then
                finding INFO "HSTS present: $value"
            else finding MEDIUM 'HSTS missing a positive max-age.'; fi
        elif [[ $key == X-Content-Type-Options && $lower != nosniff ]]; then
            finding MEDIUM "X-Content-Type-Options does not specify nosniff: $value"
        elif [[ $key == X-Frame-Options && $lower != deny && $lower != sameorigin ]]; then
            finding MEDIUM 'X-Frame-Options value is unsupported; review CSP frame-ancestors.'
        elif [[ $key == Content-Security-Policy ]]; then
            finding INFO "CSP present (presence is not proof of protection): $value"
            [[ $lower == *"'unsafe-inline'"* || $lower == *"'unsafe-eval'"* ]] && finding LOW 'CSP contains unsafe-inline or unsafe-eval; assess directive context.'
        else finding INFO "$key present: $value"; fi
    done
    if [[ -z $csp && -n $(header Content-Security-Policy-Report-Only "$f") ]]; then
        finding INFO 'Only CSP Report-Only was observed; it monitors violations without enforcing a policy.'
    fi
    for key in Server X-Powered-By X-AspNet-Version X-AspNetMvc-Version; do
        value=$(header "$key" "$f")
        [[ -n $value ]] && finding LOW "Information disclosure ($key): $value"
    done
    while IFS= read -r cookie; do
        [[ -n $cookie ]] || continue
        ((count+=1)); name=${cookie%%=*}; name=${name%%;*}
        attrs=";${cookie#*;}"; attrs=${attrs,,}
        finding INFO "Cookie $name observed (value redacted)."
        [[ $cookie == *';'* && $attrs =~ \;[[:space:]]*secure[[:space:]]*(\;|$) ]] || finding MEDIUM "Cookie $name lacks Secure."
        [[ $cookie == *';'* && $attrs =~ \;[[:space:]]*httponly[[:space:]]*(\;|$) ]] || finding MEDIUM "Cookie $name lacks HttpOnly; review whether JavaScript access is required."
        if [[ $name == __Host-* ]]; then
            [[ $attrs =~ \;[[:space:]]*path=/[[:space:]]*(\;|$) ]] || finding MEDIUM "Cookie $name violates its __Host- prefix: Path must be /."
            [[ $attrs =~ \;[[:space:]]*domain= ]] && finding MEDIUM "Cookie $name violates its __Host- prefix: Domain must be absent."
        fi
        if [[ $name == __Host-* || $name == __Secure-* ]]; then
            [[ $attrs =~ \;[[:space:]]*secure[[:space:]]*(\;|$) && $scheme == https ]] || finding MEDIUM "Cookie $name violates its secure prefix requirements."
        fi
        if [[ $cookie == *';'* && $attrs =~ \;[[:space:]]*samesite=(strict|lax|none)[[:space:]]*(\;|$) ]]; then
            if [[ ${BASH_REMATCH[1]} == none && ! $attrs =~ \;[[:space:]]*secure[[:space:]]*(\;|$) ]]; then
                finding MEDIUM "Cookie $name has SameSite=None without Secure."
            fi
        else finding MEDIUM "Cookie $name lacks a recognized SameSite attribute."; fi
        [[ $scheme == http ]] && finding MEDIUM "Cookie $name was set over plaintext HTTP."
    done < <(header Set-Cookie "$f")
    (( count > 0 )) || finding INFO 'No Set-Cookie observed on this unauthenticated response.'
}
if command -v curl >/dev/null 2>&1; then
    if request "$target" GET "$work/headers"; then
        finding INFO "HTTP response: $(head -n 1 "$work/headers")"
        audit_headers "$work/headers"
        location=$(header Location "$work/headers")
        [[ -n $location ]] && finding INFO "Redirect recorded: $(redirect_destination "$location")"
        if [[ $scheme == http ]]; then
            if is_https_redirect "$(head -n 1 "$work/headers")" "$location"; then
                finding INFO 'HTTP advertises an HTTPS redirect; destination and certificate are not verified. Assess that HTTPS URL explicitly.'
            else finding MEDIUM 'HTTP response does not immediately redirect to HTTPS.'; fi
        fi
    fi
    if request "$target" OPTIONS "$work/options"; then
        methods=$(header Allow "$work/options"); public=$(header Public "$work/options")
        methods="${methods}${public:+, $public}"
        if [[ -n $methods ]]; then
            finding INFO "Advertised methods (not actively exercised): $methods"
            [[ ${methods^^} =~ (^|[,[:space:]])(TRACE|CONNECT|PUT|DELETE|PATCH)([,[:space:]]|$) ]] && finding MEDIUM 'Potentially sensitive methods advertised; verify authorization and application requirements.'
        else finding INFO 'OPTIONS does not advertise methods; exposure is inconclusive.'; fi
    fi
    if [[ $scheme == https && $port == 443 ]]; then
        if request "http://$authority_host:80/" GET "$work/http"; then
            location=$(header Location "$work/http")
            if is_https_redirect "$(head -n 1 "$work/http")" "$location"; then
                finding INFO "Port 80 advertises HTTPS redirect: $(redirect_destination "$location") (not followed)."
            else finding MEDIUM 'Port 80 does not immediately redirect to HTTPS.'; fi
        fi
    elif [[ $scheme == https ]]; then
        finding SKIP 'HTTP counterpart port is unknown for this nonstandard HTTPS port; no extra port probed.'
    fi
else finding SKIP 'curl unavailable: headers, cookies, methods and redirects not assessed.'; fi
if [[ $scheme != https ]]; then
    finding SKIP 'TLS checks require an explicitly supplied HTTPS URL.'
elif ! command -v openssl >/dev/null 2>&1; then
    finding SKIP 'openssl unavailable: certificate and protocol checks not assessed.'
elif ! command -v timeout >/dev/null 2>&1; then
    finding SKIP 'timeout unavailable: TLS handshakes skipped to avoid unbounded network waits.'
else
    verify=(-verify_hostname "$host")
    [[ $authority_host == \[* || $host =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] && verify=(-verify_ip "$host")
    tls=(openssl s_client -connect "$authority_host:$port" -servername "$host")
    timeout 10 "${tls[@]}" -showcerts -verify_return_error "${verify[@]}" < /dev/null > "$work/tls" 2>&1
    rc=$?
    if (( rc == 0 )) && grep -q 'Verify return code: 0 (ok)' "$work/tls"; then
        finding PASS 'OpenSSL verified the certificate chain and target identity against the local trust store.'
    elif grep -Eq 'verify error:|Verification error:' "$work/tls"; then
        finding HIGH "Certificate verification failed: $(grep -E 'verify error:|Verification error:' "$work/tls" | head -n 2)"
    else finding SKIP "Verified TLS handshake unavailable (exit $rc); trust/identity result inconclusive."; fi
    awk '/-----BEGIN CERTIFICATE-----/ {active=1} active {print} /-----END CERTIFICATE-----/ {exit}' "$work/tls" > "$work/leaf"
    if openssl x509 -in "$work/leaf" -noout >/dev/null 2>&1; then
        finding INFO "Presented certificate chain count: $(grep -c -- '-----BEGIN CERTIFICATE-----' "$work/tls"); includes leaf, not necessarily root."
        finding INFO "$(openssl x509 -in "$work/leaf" -noout -subject -issuer -dates -fingerprint -sha256)"
        finding INFO "$(openssl x509 -in "$work/leaf" -noout -ext subjectAltName 2>/dev/null)"
        if ! openssl x509 -in "$work/leaf" -noout -checkend 0 >/dev/null; then
            finding HIGH 'Leaf certificate has expired.'
        elif ! openssl x509 -in "$work/leaf" -noout -checkend 2592000 >/dev/null; then
            finding MEDIUM 'Leaf certificate expires within 30 days.'
        else finding PASS 'Leaf certificate expiration is more than 30 days away (trust checked separately).'; fi
        # Chain identities are evidence; no untrusted raw handshake data is retained.
        awk '/-----BEGIN CERTIFICATE-----/ {n++; f=dir "/chain-" n ".pem"} f {print > f} /-----END CERTIFICATE-----/ {close(f); f=""}' dir="$work" "$work/tls"
        for cert in "$work"/chain-*.pem; do
            finding INFO "Chain certificate: $(openssl x509 -in "$cert" -noout -subject -issuer -dates 2>/dev/null)"
        done
        finding INFO "Negotiated posture: $(grep -E '^New, |^ *Protocol *:|^ *Cipher *:|^Server public key is' "$work/tls")"
        openssl x509 -in "$work/leaf" -noout -text > "$work/cert-details"
        signature=$(awk '/Signature Algorithm:/ {sub(/^[[:space:]]*/, ""); print; exit}' "$work/cert-details")
        finding INFO "$signature"
        [[ ${signature,,} == *md5* || ${signature,,} == *sha1* ]] && finding HIGH 'Leaf certificate uses a legacy MD5/SHA-1 signature algorithm.'
        if grep -q 'Public Key Algorithm: rsaEncryption' "$work/cert-details"; then
            bits=$(sed -n 's/.*Public-Key: (\([0-9]*\) bit).*/\1/p' "$work/cert-details" | head -n 1)
            [[ $bits =~ ^[0-9]+$ ]] && (( bits < 2048 )) && finding HIGH "Leaf RSA public key is below 2048 bits: $bits."
        fi
        cipher=$(sed -n 's/^ *Cipher *: *//p' "$work/tls" | head -n 1)
        [[ $cipher =~ (RC4|DES|NULL|EXPORT|ADH|AECDH) && $cipher != '(NONE)' ]] && finding HIGH "Weak negotiated cipher observed: $cipher"
    else finding SKIP 'No parseable leaf certificate received.'; fi
    for protocol in tls1 tls1_1 tls1_2 tls1_3; do
        if ! openssl s_client -help 2>&1 | grep -q -- "-$protocol "; then
            finding SKIP "Local OpenSSL does not support $protocol probing."; continue
        fi
        timeout 10 "${tls[@]}" -"$protocol" -brief < /dev/null > "$work/protocol" 2>&1
        if grep -q 'CONNECTION ESTABLISHED' "$work/protocol" && grep -q 'Ciphersuite:' "$work/protocol"; then
            if [[ $protocol == tls1 || $protocol == tls1_1 ]]; then
                finding HIGH "Legacy $protocol successfully negotiated."
            else finding INFO "$protocol successfully negotiated."; fi
            finding INFO "$(grep -E 'Protocol version:|Ciphersuite:' "$work/protocol")"
        else finding INFO "$protocol not negotiated; server rejection, client policy or transport may explain this. Support is inconclusive."; fi
    done
fi
finding INFO 'No exhaustive cipher enumeration, unsafe method execution, exploitation or brute force performed.'
summary="HIGH=${totals[HIGH]} MEDIUM=${totals[MEDIUM]} LOW=${totals[LOW]} PASS=${totals[PASS]} SKIP=${totals[SKIP]}"
finding INFO "Finding summary: $summary"
finding INFO "Report: $report"
if [[ ${CSTK_LOGGING_ENABLED:-on} != off && ${CSTK_LOGGING_LEVEL:-basic} != off ]]; then
    mkdir -p -- "$logs" || exit 1
    logfile=$(mktemp "$logs/web-tls-XXXXXX.log") || exit 1
    printf 'UTC: %s\nTarget: %s\nFindings: %s\nReport: %s\n' "$(date -u +%FT%TZ)" "$display_target" "$summary" "$report" > "$logfile" || exit 1
fi
exit 0
