#!/bin/bash

[[ $- == *i* ]] && { echo "This option is not available"; exit 1; }
if [[ -z "$CSTK_WRAPPER_RUNNER" ]] && [[ -z "$CSTK_MAIN_RUNNER" ]]; then
    echo "This option is unavailable, under this circumstance."
    exit 1
fi

DIR="$1"
version="1.0.5"
DATE=$(date)
USER="$SUDO_USER"
log_file="$DIR/../log/multi_reverse_shell_creater.log"
ESC=$(printf '\033') RESET="${ESC}[0m" BLACK="${ESC}[30m" RED="${ESC}[31m"
GREEN="${ESC}[32m" YELLOW="${ESC}[33m" BLUE="${ESC}[34m" MAGENTA="${ESC}[35m"
CYAN="${ESC}[36m" WHITE="${ESC}[37m" DEFAULT="${ESC}[39m"

greenprint() { printf "${GREEN}%s${RESET}\n" "$1"; }
blueprint() { printf "${BLUE}%s${RESET}\n" "$1"; }
redprint() { printf "${RED}%s${RESET}\n" "$1"; }
yellowprint() { printf "${YELLOW}%s${RESET}\n" "$1"; }
magentaprint() { printf "${MAGENTA}%s${RESET}\n" "$1"; }
cyanprint() { printf "${CYAN}%s${RESET}\n" "$1"; }
fn_bye() { printf "\n\nShell you later!\n\n"; exit 0; }
fn_fail() { echo "That is just not an option!"; mainmenu; }

function header () {
clear
blueprint "
â–‘â–ˆâ–€â–„â–‘â–ˆâ–€â–€â–‘â–ˆâ–‘â–ˆâ–‘â–ˆâ–€â–€â–‘â–ˆâ–€â–„â–‘â–ˆâ–€â–€â–‘â–ˆâ–€â–€
â–‘â–ˆâ–€â–„â–‘â–ˆâ–€â–€â–‘â–€â–„â–€â–‘â–ˆâ–€â–€â–‘â–ˆâ–€â–„â–‘â–€â–€â–ˆâ–‘â–ˆâ–€â–€
â–‘â–€â–‘â–€â–‘â–€â–€â–€â–‘â–‘â–€â–‘â–‘â–€â–€â–€â–‘â–€â–‘â–€â–‘â–€â–€â–€â–‘â–€â–€â–€"
greenprint "
â–‘â–ˆâ–€â–€â–‘â–ˆâ–‘â–ˆâ–‘â–ˆâ–€â–€â–‘â–ˆâ–‘â–‘â–‘â–ˆâ–‘â–‘
â–‘â–€â–€â–ˆâ–‘â–ˆâ–€â–ˆâ–‘â–ˆâ–€â–€â–‘â–ˆâ–‘â–‘â–‘â–ˆâ–‘â–‘
â–‘â–€â–€â–€â–‘â–€â–‘â–€â–‘â–€â–€â–€â–‘â–€â–€â–€â–‘â–€â–€â–€"
yellowprint "
â–‘â–ˆâ–€â–€â–‘â–ˆâ–€â–€â–‘â–ˆâ–€â–„â–‘â–€â–ˆâ–€â–‘â–ˆâ–€â–ˆâ–‘â–€â–ˆâ–€
â–‘â–€â–€â–ˆâ–‘â–ˆâ–‘â–‘â–‘â–ˆâ–€â–„â–‘â–‘â–ˆâ–‘â–‘â–ˆâ–€â–€â–‘â–‘â–ˆâ–‘
â–‘â–€â–€â–€â–‘â–€â–€â–€â–‘â–€â–‘â–€â–‘â–€â–€â–€â–‘â–€â–‘â–‘â–‘â–‘â–€â–‘"
magentaprint "
      v.$version"
if [ ! -z "$DIR" ]; then
    PWD="$DIR"
fi
if [ $usingngrok == 1 ]; then
    if [ $(ps -ef | grep -c ngrok) == 2 ]; then
        echo "ðŸŸ¢ ngrok is forwarding: $public_url to localport: $LOCALPORT"
        echo
    else
        echo "ðŸ”´ ngrok is not running"
        usingngrok=0
    fi
fi
if [ $usingupdog == 1  ]; then
  if [ $(ps -ef | grep -c updog) == 2 ]; then
        echo "ðŸŸ¢ Updog is listening on $updog_port, serving folder: $updog_dir"
    else
        echo "ðŸ”´ Updog is not running"
    fi
fi
echo
}
OS=$(uname)
ngrok_installed=$(which ngrok)
if [ "$?" == 1 ]; then
    ngrok_installed=0
else
    ngrok_installed=1
    killall ngrok > /dev/null 2>&1
fi
updog_installed=$(which updog)
if [ "$?" == 1 ]; then
    updog_installed=0
else
    updog_installed=1
    if [ $(ps -ef | grep -c updog) == 2 ]
    then
        ps -ef | grep updog |cut -d" " -f4| while read -r pid;do kill "$pid";done > /dev/null 2>&1
    fi
fi
usingngrok=0
usingupdog=0
benc=$(which basenc)
if [ "$?" == 1 ]; then
      header
      if [[ $OS == "Darwin" ]]; then
    redprint "$0 depends on basenc from coreutils and cannot continue.
Install on MacOS using homebrew: brew install coreutils"
    yellowprint "Install now? [Y/n]"
    read -r -n 1 ans
    case $ans in
    y)
        echo
        echo "Installing..."
        brew install coreutils
        $0;;
    n)
        exit 10 ;;
    "")
        echo
        echo "Installing..."
        brew install coreutils
        $0;;
    *)
        exit 11 ;;
    esac
    else
    redprint "$0 depends on on basenc from coreutils and cannot continue.
Install on Debian: sudo apt install coreutils"
    yellowprint "Install now? [Y/n]"
    read -r -n 1 ans
    case $ans in
    y)
        echo
        echo "Installing..."
        sudo apt install coreutils
        $0;;
    n)
        exit 10 ;;
    "")
        echo
        echo "Installing..."
        sudo apt install coreutils
        $0;;
    *)
        exit 11 ;;
    esac
    fi
exit
fi
if [[ $OS == "Darwin" ]]; then
    sed=$(which gsed)
    if [ "$?" == 1 ]; then
        redprint "$0 depends on gnu-sed cannot continue.
        Install on MacOS using homebrew: brew install gnu-sed"
        yellowprint "Install now? [Y/n]"
        read -r -n 1 ans
        case $ans in
        y)
            echo
            echo "Installing..."
            brew install gnu-sed
            $0;;
        n)
            exit 10 ;;
        "")
            echo
            echo "Installing..."
            brew install gnu-sed
            $0;;
            *)
            exit 11 ;;
        esac
    else
        echo
    fi
else
    sed=$(which sed)
fi
